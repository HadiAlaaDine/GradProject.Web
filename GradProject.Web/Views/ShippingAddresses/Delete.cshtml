@model GradProject.Web.Models.ShippingAddress
@{
    ViewBag.Title = "Delete Address";
}

<h2>Delete Address</h2>

@Html.Partial("_Alerts")

<div class="alert alert-danger">
    <strong>Warning:</strong> This action cannot be undone. Are you sure you want to delete this address?
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.Phone</dd>

            <dt class="col-sm-3">Address</dt>
            <dd class="col-sm-9">
                @Model.AddressLine1
                @if (!string.IsNullOrWhiteSpace(Model.AddressLine2))
                {<text>, @Model.AddressLine2</text>}
            </dd>

            <dt class="col-sm-3">City</dt>
            <dd class="col-sm-9">
                @Model.City
                @if (!string.IsNullOrWhiteSpace(Model.State))
                {<text> - @Model.State</text>}
            </dd>

            <dt class="col-sm-3">Country</dt>
            <dd class="col-sm-9">
                @Model.Country
                @if (!string.IsNullOrWhiteSpace(Model.PostalCode))
                {<text> (@Model.PostalCode)</text>}
            </dd>

            <dt class="col-sm-3">Default</dt>
            <dd class="col-sm-9">@((Model.IsDefault) ? "Yes" : "No")</dd>
        </dl>
    </div>
</div>

@using (Html.BeginForm("Delete", "ShippingAddresses", FormMethod.Post, new { @class = "d-inline" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <button type="submit" class="btn btn-danger">Delete</button>
}
@Html.ActionLink("Cancel", "Index", "ShippingAddresses", null, new { @class = "btn btn-outline-secondary ms-2" })

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
