@model GradProject.Web.Models.ViewModels.ProfileViewModel
@{
    ViewBag.Title = "My Profile";
}

<h2>My Profile</h2>

@Html.Partial("_Alerts")

<div class="card mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Username</dt>
            <dd class="col-sm-9">@Model.UserName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Orders Count</dt>
            <dd class="col-sm-9">@Model.OrdersCount</dd>

            <dt class="col-sm-3">Last Order</dt>
            <dd class="col-sm-9">
                @(Model.LastOrderAt.HasValue ? Model.LastOrderAt.Value.ToString("yyyy-MM-dd HH:mm") : "—")
            </dd>
        </dl>

        <div class="mt-2">
            @Html.ActionLink("My Orders", "Index", "Orders", null, new { @class = "btn btn-primary btn-sm" })
        </div>
    </div>
</div>
