@model GradProject.Web.Models.Order
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = "Order #" + Model.Id;
    var usd = System.Globalization.CultureInfo.GetCultureInfo("en-US");
    decimal total = Model.Items?.Sum(it => it.UnitPrice * it.Quantity) ?? 0m;

    Func<GradProject.Web.Models.OrderStatus, string> badge = s =>
        s == GradProject.Web.Models.OrderStatus.Pending ? "badge bg-secondary" :
        s == GradProject.Web.Models.OrderStatus.Processing ? "badge bg-info" :
        s == GradProject.Web.Models.OrderStatus.Shipped ? "badge bg-primary" :
        s == GradProject.Web.Models.OrderStatus.Completed ? "badge bg-success" : "badge bg-danger";
}

<h2>Order #@Model.Id</h2>

<p class="text-muted">
    Created: @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
    | Payment: <strong>@Model.PaymentMethod</strong>
    | Status: <span class="@badge(Model.Status)">@Model.Status</span>
</p>

<div class="mb-3">
    @Html.ActionLink("Back to Orders", "Index", "Orders", null, new { @class = "btn btn-outline-secondary me-2" })
    @Html.ActionLink("Download Invoice (PDF)", "Invoice", "Orders", new { id = Model.Id }, new { @class = "btn btn-success btn-sm me-2" })

    @* زر الإلغاء يظهر للمستخدم صاحب الطلب أو الأدمن، وفقط إن كانت الحالة قابلة للإلغاء *@
    @if ((User.IsInRole("Admin") || User.Identity.GetUserId() == Model.UserId) &&
        (Model.Status == GradProject.Web.Models.OrderStatus.Pending ||
         Model.Status == GradProject.Web.Models.OrderStatus.Processing))
    {
        using (Html.BeginForm("Cancel", "Orders", FormMethod.Post, new { @class = "d-inline" }))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("id", Model.Id)
            <button type="submit" class="btn btn-danger btn-sm"
                    onclick="return confirm('Are you sure you want to cancel this order?');">
                Cancel Order
            </button>
        }
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.ShipFullName) ||
    !string.IsNullOrWhiteSpace(Model.ShipAddress1) ||
    !string.IsNullOrWhiteSpace(Model.ShipCity) ||
    !string.IsNullOrWhiteSpace(Model.ShipCountry) ||
    !string.IsNullOrWhiteSpace(Model.ShipPhone))
{
    <div class="card mb-3">
        <div class="card-header">Shipping Information</div>
        <div class="card-body">
            <div class="row">
                <div class="col-sm-6 mb-2"><strong>Name:</strong> @(!string.IsNullOrWhiteSpace(Model.ShipFullName) ? Model.ShipFullName : "-")</div>
                <div class="col-sm-6 mb-2"><strong>Phone:</strong> @(!string.IsNullOrWhiteSpace(Model.ShipPhone) ? Model.ShipPhone : "-")</div>
                <div class="col-sm-12 mb-2"><strong>Address 1:</strong> @(!string.IsNullOrWhiteSpace(Model.ShipAddress1) ? Model.ShipAddress1 : "-")</div>
                <div class="col-sm-12 mb-2"><strong>Address 2:</strong> @(!string.IsNullOrWhiteSpace(Model.ShipAddress2) ? Model.ShipAddress2 : "-")</div>
                <div class="col-sm-6 mb-2"><strong>City:</strong> @(!string.IsNullOrWhiteSpace(Model.ShipCity) ? Model.ShipCity : "-")</div>
                <div class="col-sm-6 mb-2"><strong>Country:</strong> @(!string.IsNullOrWhiteSpace(Model.ShipCountry) ? Model.ShipCountry : "-")</div>
            </div>
        </div>
    </div>
}

@if (User.IsInRole("Admin"))
{
    using (Html.BeginForm("UpdateStatus", "Orders", FormMethod.Post, new { @class = "row g-2 mb-3" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("id", Model.Id)
        <div class="col-auto">
            <select name="status" class="form-select">
                @foreach (var s in Enum.GetNames(typeof(GradProject.Web.Models.OrderStatus)))
                {
                    <option value="@s" @(s == Model.Status.ToString() ? "selected" : "")>@s</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Update Status</button>
        </div>
    }
}

@if (Model.Items == null || !Model.Items.Any())
{
    <div class="alert alert-info">No items in this order.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="table-light">
            <tr>
                <th style="width:60px">#</th>
                <th>Product</th>
                <th class="text-end">Unit Price (USD)</th>
                <th class="text-center">Qty</th>
                <th class="text-end">Subtotal (USD)</th>
            </tr>
        </thead>
        <tbody>
            @{
                var i = 1;
            }
            @foreach (var it in Model.Items)
            {
                var name = it.Product != null ? it.Product.Name : "(deleted product)";
                var sub = it.UnitPrice * it.Quantity;
                <tr>
                    <td>@(i++)</td>
                    <td>@name</td>
                    <td class="text-end">@it.UnitPrice.ToString("C", usd)</td>
                    <td class="text-center">@it.Quantity</td>
                    <td class="text-end">@sub.ToString("C", usd)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="4" class="text-end">Total</th>
                <th class="text-end">@total.ToString("C", usd)</th>
            </tr>
        </tfoot>
    </table>
}
