@using GradProject.Web.Controllers
@model IEnumerable<CartItem>

@{
    ViewBag.Title = "My Shopping Cart";
    decimal grandTotal = Model == null ? 0 : Model.Sum(x => x.Product.Price * x.Quantity);
}

<div style="display: flex; justify-content: space-between; align-items: center;">
    <h2>🛒 My Shopping Cart</h2>
    @if (Model != null && Model.Any())
    {
        <a href="@Url.Action("ClearCart", "Cart")" class="btn btn-danger btn-sm" onclick="return confirm('Clear all items?');">
            <i class="glyphicon glyphicon-trash"></i> Clear All
        </a>
    }
</div>
<hr />

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info text-center">
        <h3>Your cart is empty! 😢</h3>
        <a href="@Url.Action("Index", "Products")" class="btn btn-primary">Start Shopping</a>
    </div>
}
else
{
    <table class="table table-hover table-bordered text-center" style="background-color: white;">
        <thead>
            <tr class="active">
                <th class="text-left">Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Subtotal</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-left" style="vertical-align: middle;">
                        @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                        {
                            <img src="@Url.Content(item.Product.ImageUrl)" style="width: 40px; height: 40px; object-fit: cover; margin-right: 10px; border-radius: 4px;" />
                        }
                        <strong>@item.Product.Name</strong>
                    </td>
                    <td style="vertical-align: middle;">$@item.Product.Price</td>

                    <td style="vertical-align: middle;">
                        <div class="btn-group btn-group-sm">
                            <a href="@Url.Action("DecreaseQty", "Cart", new { id = item.Product.Id })" class="btn btn-default">-</a>
                            <button type="button" class="btn btn-default disabled" style="color: black; font-weight: bold;">@item.Quantity</button>

                            <a href="@Url.Action("IncreaseQty", "Cart", new { id = item.Product.Id })" class="btn btn-default">+</a>
                        </div>
                    </td>

                    <td style="vertical-align: middle; font-weight: bold; color: #18bc9c;">
                        $@(item.Product.Price * item.Quantity)
                    </td>

                    <td style="vertical-align: middle;">
                        <a href="@Url.Action("Remove", "Cart", new { id = item.Product.Id })" class="text-danger">
                            <i class="glyphicon glyphicon-remove"></i> Remove
                        </a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr style="background-color: #f8f9fa;">
                <td colspan="3" class="text-right" style="font-weight: bold; font-size: 1.2em;">Grand Total:</td>
                <td style="font-weight: bold; font-size: 1.2em; color: #e74c3c;">$@grandTotal</td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    <div class="row">
        <div class="col-md-6">
            <a href="@Url.Action("Index", "Products")" class="btn btn-default">&larr; Continue Shopping</a>
        </div>
        <div class="col-md-6 text-right">
            <a href="@Url.Action("Checkout", "Cart")" class="btn btn-success btn-lg btn-block">
                Checkout via WhatsApp 📱
            </a>
        </div>
    </div>
}