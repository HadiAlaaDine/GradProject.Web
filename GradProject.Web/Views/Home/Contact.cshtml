@{
    ViewBag.Title = "Contact Us";
}

<div class="container" style="margin-bottom: 50px;">
    <div class="row">
        <div class="col-md-12 text-center" style="margin-top: 50px; margin-bottom: 50px;">
            <h1 style="font-weight: bold; font-size: 3em; color: #2c3e50;">Contact Click & Pick 📞</h1>
            <p class="lead" style="color: #7f8c8d;">We're here to help you pick the best.</p>
            <hr style="width: 100px; border: 2px solid #e74c3c;" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-5">
            <div style="background-color: #2c3e50; color: white; padding: 30px; border-radius: 15px; height: 100%;">
                <h3 style="margin-bottom: 20px;">Contact Info</h3>

                <p style="margin-bottom: 15px;">
                    <span class="glyphicon glyphicon-map-marker" style="margin-right: 10px; color: #18bc9c;"></span>
                    Tripoli, Lebanon
                </p>

                <p style="margin-bottom: 15px;">
                    <span class="glyphicon glyphicon-phone" style="margin-right: 10px; color: #18bc9c;"></span>
                    +961 71 76 32 34
                </p>

                <p style="margin-bottom: 15px;">
                    <span class="glyphicon glyphicon-envelope" style="margin-right: 10px; color: #18bc9c;"></span>
                    info@clickandpick.com
                </p>

                <hr style="border-top: 1px solid #555;" />

                <h4>Business Hours</h4>
                <p>Mon - Fri: 9:00 AM - 6:00 PM</p>
                <p>Sat - Sun: Closed</p>
            </div>
        </div>

        <div class="col-md-7">
            <div style="padding: 30px; border: 1px solid #ddd; border-radius: 15px; background-color: white;">
                <h3>Send us a Message</h3>
                <form>
                    <div class="form-group">
                        <label>Your Name</label>
                        <input type="text" class="form-control" placeholder="Enter your name" />
                    </div>
                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" class="form-control" placeholder="Enter your email" />
                    </div>
                    <div class="form-group">
                        <label>Subject</label>
                        <input type="text" class="form-control" placeholder="Subject" />
                    </div>
                    <div class="form-group">
                        <label>Message</label>
                        <textarea class="form-control" rows="5" placeholder="How can we help?"></textarea>
                    </div>
                    <button type="button" class="btn btn-success btn-lg btn-block" onclick="alert('Message sent to Click & Pick Team! 🚀')">Send Message 🚀</button>
                </form>
            </div>
        </div>
    </div>
</div>