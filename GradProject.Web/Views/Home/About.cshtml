@{
    ViewBag.Title = "About Us";
}

<div class="container" style="margin-bottom: 50px;">
    <div class="row">
        <div class="col-md-12 text-center" style="margin-top: 50px; margin-bottom: 50px;">
            <h1 style="font-weight: bold; font-size: 3em; color: #2c3e50;">Who We Are 🌟</h1>
            <p class="lead" style="color: #7f8c8d;">Just <strong>Click</strong> & <strong>Pick</strong> what you love.</p>
            <hr style="width: 100px; border: 2px solid #18bc9c;" />
        </div>
    </div>

    <div class="row align-items-center" style="display: flex; flex-wrap: wrap; align-items: center;">
        <div class="col-md-6">
            <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Team" class="img-responsive img-thumbnail" style="border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.1);">
        </div>
        <div class="col-md-6">
            <h2 style="color: #2c3e50; font-weight: bold;">Our Story</h2>
            <p style="font-size: 1.1em; line-height: 1.8; color: #555;">
                Welcome to <strong>Click & Pick</strong>, your ultimate destination for luxury Cars, latest Phones, and inspiring Books. Our name says it all: we make your shopping experience as simple as a click.
            </p>
            <p style="font-size: 1.1em; line-height: 1.8; color: #555;">
                Founded in @DateTime.Now.Year, <strong>Click & Pick</strong> has come a long way from its beginnings. We serve customers all over the region and are thrilled to be a part of the eco-friendly wing of the industry.
            </p>
            <br />
            <a href="@Url.Action("Contact", "Home")" class="btn btn-primary btn-lg">Get in Touch</a>
        </div>
    </div>

    <br /><br />

    <div class="row text-center" style="background-color: #f8f9fa; padding: 50px 0; border-radius: 15px;">
        <div class="col-md-4">
            <h1 style="color: #18bc9c; font-weight: bold;">1000+</h1>
            <h4>Happy Clickers 😊</h4>
        </div>
        <div class="col-md-4">
            <h1 style="color: #3498db; font-weight: bold;">500+</h1>
            <h4>Items Picked 📦</h4>
        </div>
        <div class="col-md-4">
            <h1 style="color: #e74c3c; font-weight: bold;">24/7</h1>
            <h4>Support 🕒</h4>
        </div>
    </div>
</div>